# Read by vite.config.ts on the server side and never exposed to the browser.
# Needs: repo (or public_repo), read:org, and workflow scope for re-runs.
GITHUB_TOKEN=

# Leave unset for github.com. For Enterprise Server use the /api/v3 base:
# GITHUB_API_BASE=https://github.acme-corp.com/api/v3
GITHUB_API_BASE=https://api.github.com

# These two are safe in the client bundle — they are not secrets.
VITE_GITHUB_REPOS=acme-corp/payments-api,acme-corp/platform-core,acme-corp/web-app
VITE_GITHUB_ORG=acme-corp
